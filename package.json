{
  "name": "@stevendeeds/decree",
  "version": "0.0.0",
  "private": true,
  "description": "Decree — design system enforcement layer",
  "type": "module",
  "bin": {
    "decree": "./bin/decree.js",
    "decree-mcp": "./bin/decree-mcp.js"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "verify:clean": "node ./bin/decree.js verify fixtures/shadcn-clean",
    "verify:dirty": "node ./bin/decree.js verify fixtures/shadcn-dirty",
    "verify:mui": "node ./bin/decree.js verify fixtures/mui-clean && node ./bin/decree.js verify fixtures/mui-dirty; test $? -eq 1",
    "verify:radix": "node ./bin/decree.js verify examples/radix-themes-clean && node ./bin/decree.js verify examples/radix-themes-dirty; test $? -eq 1",
    "verify": "node ./bin/decree.js verify",
    "init:sample": "node ./bin/decree.js init fixtures/init-sample-pkg --out /tmp/decree-init-sample.contract.json --force",
    "examples:install": "bash ./scripts/examples-install.sh",
    "examples:init": "bash ./scripts/examples-init.sh",
    "examples:verify": "bash ./scripts/examples-verify.sh",
    "demo": "npm run examples:verify",
    "trials": "node ./scripts/run-external-trials.mjs",
    "mcp:config": "node ./bin/decree.js mcp fixtures/shadcn-clean/decree.contract.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
