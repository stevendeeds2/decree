{
  "name": "@stevendeeds/decree",
  "version": "0.2.1",
  "description": "Check apps and AI agents against your design system: components, props, and tokens.",
  "type": "module",
  "bin": {
    "decree": "bin/decree.js",
    "decree-mcp": "bin/decree-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/INSTALL.md",
    "docs/ADOPTION.md",
    "docs/GETTING_STARTED.md",
    "docs/INIT.md",
    "docs/SOURCES.md",
    "docs/ADAPTERS.md",
    "docs/MCP.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify": "node ./bin/decree.js verify",
    "demo:verify": "node ./bin/decree.js verify demos/shadcn/apps/app",
    "demo:together": "node ./demos/together/prove.mjs",
    "pack:check": "node ./scripts/pack-check.mjs",
    "pack:smoke": "node ./scripts/pack-smoke.mjs",
    "mcp:config": "node ./bin/decree.js mcp demos/shadcn/packages/ui/decree.contract.json",
    "prepublishOnly": "npm test && npm run pack:check && npm run pack:smoke && npm run demo:verify"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevendeeds2/decree.git"
  },
  "bugs": {
    "url": "https://github.com/stevendeeds2/decree/issues"
  },
  "homepage": "https://github.com/stevendeeds2/decree#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@angular/compiler": "^21.2.25",
    "@babel/parser": "^7.29.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vue/compiler-sfc": "^3.5.44",
    "svelte": "^5.57.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "lint",
    "ci",
    "mcp",
    "components",
    "jsx",
    "vue",
    "svelte",
    "angular",
    "lit"
  ]
}
