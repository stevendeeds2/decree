{
  "version": 1,
  "components": {
    "include": ["src/components/ui"],
    "exclude": ["**/*.stories.*", "**/*.test.*"]
  },
  "tokens": {
    "mode": "css-allowlist",
    "cssAllowlist": ["src/tokens.css"]
  },
  "ignoreComponentNames": ["App"],
  "nativeElementMap": {
    "button": "Button",
    "input": "Input",
    "select": "Select"
  },
  "componentApis": {
    "Button": {
      "props": {
        "variant": {
          "enum": ["default", "destructive", "outline", "secondary", "ghost", "link"]
        },
        "size": {
          "enum": ["default", "sm", "lg", "icon"]
        },
        "asChild": { "type": "boolean" },
        "disabled": { "type": "boolean" }
      }
    }
  },
  "restyle": true
}
